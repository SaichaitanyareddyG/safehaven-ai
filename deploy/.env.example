# Copy to deploy/.env and fill in. deploy.sh generates the two secrets for you.
# DEMO DATA ONLY: nothing here is HIPAA-covered (standard OpenAI key, home server).

# Database (inside the server; never exposed)
POSTGRES_USER=safehaven
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safehaven

# Login tokens — a long random string (deploy.sh generates one)
JWT_SECRET_KEY=change-me

# The public addresses (Tailscale Funnel: https://<name>.<tailnet>.ts.net)
#   dashboard on 443, backend (and the bands) on 8443
PUBLIC_API_URL=https://your-server.your-tailnet.ts.net:8443
CORS_ORIGINS=https://your-server.your-tailnet.ts.net

# AI through OpenAI (Modules 1-2 and the band's voice assistant)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
BAND_TALK_PROVIDER=openai

HOSPITAL_TIMEZONE=Asia/Kolkata

# 127.0.0.1 = only Tailscale Funnel on this machine reaches it (recommended).
# 0.0.0.0  = also reachable on the local network by IP.
BIND_ADDR=127.0.0.1
