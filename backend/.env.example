ENVIRONMENT=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://safehaven:safehaven@localhost:5432/safehaven
TEST_DATABASE_URL=postgresql+psycopg2://safehaven:safehaven@localhost:5432/safehaven_test

# Auth — "dev" is the only implemented provider in Phase 1.
# A CognitoAuthProvider can be added later behind the same AuthProvider interface.
AUTH_PROVIDER=dev
JWT_SECRET_KEY=change-me-in-real-env-min-32-chars-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI — "mock" is the only implemented provider so far (added in a later step).
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Never persist raw prompts/responses (may contain PHI) unless explicitly enabled for local debugging.
STORE_RAW_LLM_DATA=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# The hospital's local wall-clock timezone (IANA name). Module 2 uses this to
# decide whether a dose scheduled "in the morning" is being given on time.
# MUST match where the nurses actually are: left at UTC in a non-UTC hospital,
# every correctly-timed morning dose is reported as outside its window. The app
# refuses to start if this isn't a valid IANA zone.
HOSPITAL_TIMEZONE=UTC
