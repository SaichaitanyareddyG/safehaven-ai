# Python
backend/.venv/
__pycache__/
*.pyc

# Env
.env
backend/.env

# Node / frontend (created in a later step)
frontend/node_modules/
frontend/dist/

# OS
.DS_Store

# Regenerable demo recording (produced by demo-assets/playwright-videos/record_full_demo.mjs)
demo-assets/playwright-videos/*.mp4

# Firmware build artifacts
firmware/native/build/
firmware/.pio/

# Real-device Wi-Fi credentials (copy from wifi_secrets.example.h)
firmware/include/wifi_secrets.h
# Dev backend CA for the band (backend/scripts/dev_tls.sh) — machine-specific
firmware/include/backend_ca.h

# Server secrets (deploy/.env.example is the template)
deploy/.env
deploy/.env.*
!deploy/.env.example

# Cloudflare wrangler working files
.wrangler/
